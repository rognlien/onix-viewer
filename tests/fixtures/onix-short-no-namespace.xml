  <header>
    <sender>
      <x300>Bokbasen AS</x300>
    </sender>
  </header>
  <product>
    <a001>no-namespace-short-1</a001>
    <a002>03</a002>
    <productidentifier>
      <b221>15</b221>
      <b244>9788234567892</b244>
    </productidentifier>
    <descriptivedetail>
      <b012>BC</b012>
    </descriptivedetail>
  </product>
</ONIXmessage>
