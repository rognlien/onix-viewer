			<xs:maxInclusive value="100" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="dt.Integer">
		<xs:annotation>
			<xs:documentation>Datatype for any integer (including negative numbers and zero)</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:int" />
	</xs:simpleType>
	<xs:simpleType name="dt.PositiveInteger">
		<xs:annotation>
			<xs:documentation>Datatype for any positive integer (not including zero)</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:positiveInteger" />
	</xs:simpleType>
	<xs:simpleType name="dt.PositiveIntegerOrZero">
		<xs:annotation>
			<xs:documentation>Datatype for zero or any positive integer</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:nonNegativeInteger" />
	</xs:simpleType>
	<xs:simpleType name="dt.NonEmptyString">
		<xs:annotation>
			<xs:documentation>Datatype for non-empty string, without leading or trailing white space</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="\S(.*\S)?" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="dt.EmailString">
		<xs:annotation>
			<xs:documentation>Datatype for plausible e-mail address</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="[A-Za-z0-9_]+([\-+.'][A-Za-z0-9_]+)*@[A-Za-z0-9_]+([\-.][A-Za-z0-9_]+)*\.[A-Za-z0-9_]+([\-.][A-Za-z0-9_]+)*" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="dt.RomanNumeralString">
		<xs:annotation>
			<xs:documentation>Datatype for Roman numerals (upper or lower case)</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="([MDCLXVI]+|[mdclxvi]+)" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="dt.NonEmptyURI">
		<xs:annotation>
			<xs:documentation>Datatype for URI, without leading or trailing white space</xs:documentation>
			<xs:documentation>NB use CDATA to avoid escaping &amp; if there is more than a single query parameter</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:anyURI">
			<xs:pattern value="\S+" />
			<xs:assertion id="_20210820_a_1" test="matches($value, '^[!-~]*$') or not(matches($value, '^.*://.*$'))" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="dt.TimeOrDuration">
		<xs:annotation>
			<xs:documentation>Datatype for duration HHHmmss(cc)</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="[0-9]{3}[0-5][0-9][0-5][0-9]([0-9]{2})?" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="dt.Year">
		<xs:annotation>
			<xs:documentation>Datatype for year 1000 to 2099</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="(1[0-9]{3}|20[0-9]{2})" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="dt.YearOrYearRange">
		<xs:annotation>
			<xs:documentation>Datatype for year or range of years 1000-2099</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="(1[0-9]{3}|20[0-9]{2})(-(1[0-9]{3}|20[0-9]{2}))?" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="dt.MultiLevelNumber">
		<xs:annotation>
			<xs:documentation>Datatype for string of dot-separated numbers, eg 3.12.8</xs:documentation>
			<xs:documentation>● Improved pattern to disallow using zero at any level from revision 3.1.3</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="[1-9][0-9]*(\.[1-9][0-9]*)*" />
		</xs:restriction>
	</xs:simpleType>
	<xs:simpleType name="dt.MultiLevelNumberOrHyphen">
		<xs:annotation>
			<xs:documentation>Datatype for string of dot-separated numbers where hyphen can replace a number, eg 3.-.8</xs:documentation>
			<xs:documentation>● Improved pattern to disallow using zero at any level from revision 3.1.3</xs:documentation>
		</xs:annotation>
		<xs:restriction base="xs:string">
			<xs:pattern value="([1-9][0-9]*|-)(\.([1-9][0-9]*|-))*" />
		</xs:restriction>
	</xs:simpleType>
	<xs:complexType name="EpubLicenseType">
		<xs:annotation>
			<xs:documentation>Details of an end user license agreement for a digital product</xs:documentation>
			<xs:documentation>● Is extended by OTHER complexType &lt;EpubLicenseWithDateType></xs:documentation>
			<xs:documentation>● Added at revision 3.0.2</xs:documentation>
		</xs:annotation>
		<xs:sequence>
			<xs:element maxOccurs="unbounded" ref="x511" />
			<xs:element minOccurs="0" maxOccurs="unbounded" ref="epublicenseexpression" />
		</xs:sequence>
		<xs:attribute name="refname">
			<xs:simpleType>
				<xs:restriction base="xs:token">
					<xs:enumeration value="EpubLicense" />
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attribute name="shortname">
			<xs:simpleType>
				<xs:restriction base="xs:token">
					<xs:enumeration value="epublicense" />
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
		<xs:attributeGroup ref="generalAttributes" />
		<xs:assert id="_20240205_b_4" test="(: Repeats of EpubLicenseName must each have a (unique) language attribute :)
		(count(EpubLicenseName) le 1) or
		(count(EpubLicenseName) eq count(EpubLicenseName/@language))" />
	</xs:complexType>
	<xs:complexType name="EpubLicenseWithDateType">
		<xs:annotation>
			<xs:documentation>Details of an end user license agreement for a digital product</xs:documentation>
			<xs:documentation>● Extends complexType &lt;EpubLicenseType></xs:documentation>
			<xs:documentation>● Added &lt;EpubLicenseDate> at release 3.1</xs:documentation>
		</xs:annotation>
		<xs:complexContent>
			<xs:extension base="EpubLicenseType">
				<xs:sequence>
					<xs:element minOccurs="0" maxOccurs="unbounded" ref="epublicensedate" />
				</xs:sequence>
			</xs:extension>
		</xs:complexContent>
	</xs:complexType>
	<xs:attributeGroup name="releaseAttribute">
		<xs:annotation>
			<xs:documentation>Must be 3.1 for this release</xs:documentation>
		</xs:annotation>
		<xs:attribute name="release" use="required">
			<xs:simpleType>
				<xs:restriction base="xs:string">
					<xs:enumeration value="3.1" />
				</xs:restriction>
			</xs:simpleType>
		</xs:attribute>
	</xs:attributeGroup>
	<xs:attributeGroup name="collationkeyAttribute">
		<xs:annotation>
			<xs:documentation>Phonetic or glossed rendering of textual data, generally for sorting purposes (eg Japanese kana / furigana)</xs:documentation>
			<xs:documentation>● Added at revision 3.0.1</xs:documentation>
		</xs:annotation>
		<xs:attribute name="collationkey" type="dt.NonEmptyString" />
	</xs:attributeGroup>
	<xs:attributeGroup name="generalAttributes">
		<xs:annotation>
			<xs:documentation>Standard attributes for all ONIX data elements</xs:documentation>
			<xs:documentation>● Date last changed or confirmed to be correct</xs:documentation>
			<xs:documentation>● Source authority for the data element</xs:documentation>
			<xs:documentation>● Type of organization that is the source authority</xs:documentation>
		</xs:annotation>
		<xs:attribute name="datestamp" type="dt.DateOrDateTime" />
		<xs:attribute name="sourcename" type="dt.NonEmptyString" />
		<xs:attribute name="sourcetype" type="List3" />
	</xs:attributeGroup>
	<xs:attributeGroup name="dateformatAttribute">
		<xs:annotation>
			<xs:documentation>Format of date data element, eg YYYYMMDD</xs:documentation>
			<xs:documentation>● Added at revision 3.0 (2010)</xs:documentation>
		</xs:annotation>
		<xs:attribute name="dateformat" type="List55" />
	</xs:attributeGroup>
	<xs:attributeGroup name="languageAttribute">
		<xs:annotation>
			<xs:documentation>Language of textual data element</xs:documentation>
			<xs:documentation>Note ONIX does not use the xml:lang attribute</xs:documentation>
		</xs:annotation>
		<xs:attribute name="language" type="List74" />
	</xs:attributeGroup>
	<xs:attributeGroup name="textcaseAttribute">
		<xs:annotation>
			<xs:documentation>Case of textual data, eg ALL CAPS, Title Case, Sentence case</xs:documentation>
		</xs:annotation>
		<xs:attribute name="textcase" type="List14" />
	</xs:attributeGroup>
	<xs:attributeGroup name="textformatAttribute">
		<xs:annotation>
			<xs:documentation>Markup of textual data element (eg No markup [either Ascii, or 'according to the encoding'], HTML or XHTML)</xs:documentation>
		</xs:annotation>
		<xs:attribute name="textformat" type="List34" />
	</xs:attributeGroup>
	<xs:attributeGroup name="textscriptAttribute">
		<xs:annotation>
			<xs:documentation>Script of transliterated textual data element</xs:documentation>
			<xs:documentation>● Added at revision 3.0.1</xs:documentation>
		</xs:annotation>
		<xs:attribute name="textscript" type="List121" />
	</xs:attributeGroup>
</xs:schema>
