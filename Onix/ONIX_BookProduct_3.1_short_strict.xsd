			<xs:assert id="_20240412_b_5" test="(: ProductFormFeatureValue must be a list of EUDR Due Diligence Statement document references (with optional verification codes) :) (b334 ne '51') or matches(b335, '^[0-9A-Za-z]+(\+[0-9A-Za-z]+)?( [0-9A-Za-z]+(\+[0-9A-Za-z]+)?)*$')" />
