			<xs:assert id="_20171126_c_14" test="(: IDValue must be a valid ISBN-13 (check digit error) :) not(matches(b221, '^(15|24)$')) or not(matches(b244, '^(978[0-9]{10}|979[1-9][0-9]{9})$')) or (number(substring(b244, 1, 1)) + number(substring(b244, 3, 1)) + number(substring(b244, 5, 1)) + number(substring(b244, 7, 1)) + number(substring(b244, 9, 1)) + number(substring(b244, 11, 1)) + number(substring(b244, 13, 1)) + 3 * (number(substring(b244, 2, 1)) + number(substring(b244, 4, 1)) + number(substring(b244, 6, 1)) + number(substring(b244, 8, 1)) + number(substring(b244, 10, 1)) + number(substring(b244, 12, 1)))) mod 10 eq 0" />
