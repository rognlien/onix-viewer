			</xs:attribute>
			<xs:attributeGroup ref="generalAttributes" />
			<xs:assert id="_20171126_b_1" test="(: There must be an IDTypeName if (and only if) IDType is proprietary :) matches(m380, '^(01|02)$') eq exists(b233)" />
			<xs:assert id="_20171126_b_2" test="(: IDValue must be a valid GLN (invalid characters) :) (m380 ne '06') or matches(b244, '^[0-9]{13}$')" />
			<xs:assert id="_20171126_b_3" test="(: IDValue must be a valid GLN (check digit error) :) (m380 ne '06') or not(matches(b244, '^[0-9]{13}$')) or (number(substring(b244, 1, 1)) + number(substring(b244, 3, 1)) + number(substring(b244, 5, 1)) + number(substring(b244, 7, 1)) + number(substring(b244, 9, 1)) + number(substring(b244, 11, 1)) + number(substring(b244, 13, 1)) + 3 * (number(substring(b244, 2, 1)) + number(substring(b244, 4, 1)) + number(substring(b244, 6, 1)) + number(substring(b244, 8, 1)) + number(substring(b244, 10, 1)) + number(substring(b244, 12, 1)))) mod 10 eq 0" />
			<xs:assert id="_20171126_b_4" test="(: IDValue must be a valid SAN (invalid characters) :) (m380 ne '07') or matches(b244, '^[0-9]{6}[0-9Xx]$')" />
