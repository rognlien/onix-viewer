			<xs:assert id="_20171126_c_9" test="(: IDValue must be a valid ISBN-10 (check digit error) :) (b221 ne '02') or not(matches(b244, '^[0-9]{9}[0-9Xx]$')) or (10 * number(substring(b244, 1, 1)) + 9 * number(substring(b244, 2, 1)) + 8 * number(substring(b244, 3, 1)) + 7 * number(substring(b244, 4, 1)) + 6 * number(substring(b244, 5, 1)) + 5 * number(substring(b244, 6, 1)) + 4 * number(substring(b244, 7, 1)) + 3 * number(substring(b244, 8, 1)) + 2 * number(substring(b244, 9, 1)) + (if (matches(substring(b244, 10, 1), '^(X|x)$')) then 10 else number(substring(b244, 10, 1)))) mod 11 eq 0" />
