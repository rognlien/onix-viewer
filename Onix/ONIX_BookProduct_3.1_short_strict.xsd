			<xs:assert id="_20171126_c_18" test="(: IDValue must be a valid UPC-12 (check digit error) :) (b221 ne '04') or not(matches(b244, '^[0-9]{12}$')) or (3 * (number(substring(b244, 1, 1)) + number(substring(b244, 3, 1)) + number(substring(b244, 5, 1)) + number(substring(b244, 7, 1)) + number(substring(b244, 9, 1)) + number(substring(b244, 11, 1))) + number(substring(b244, 2, 1)) + number(substring(b244, 4, 1)) + number(substring(b244, 6, 1)) + number(substring(b244, 8, 1)) + number(substring(b244, 10, 1)) + number(substring(b244, 12, 1))) mod 10 eq 0" />
			<xs:assert id="_20171126_c_19" test="(: IDValue must be a valid UPC-12+5 (check digit error) :) (b221 ne '30') or not(matches(b244, '^[0-9]{17}$')) or (3 * (number(substring(b244, 1, 1)) + number(substring(b244, 3, 1)) + number(substring(b244, 5, 1)) + number(substring(b244, 7, 1)) + number(substring(b244, 9, 1)) + number(substring(b244, 11, 1))) + number(substring(b244, 2, 1)) + number(substring(b244, 4, 1)) + number(substring(b244, 6, 1)) + number(substring(b244, 8, 1)) + number(substring(b244, 10, 1)) + number(substring(b244, 12, 1))) mod 10 eq 0" />
