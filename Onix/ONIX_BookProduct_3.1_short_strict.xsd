			<xs:assert id="_20240412_b_2" test="(: EUDR data in Product form feature description must be a comma-separated list of GPS coordinates, or a semicolon-separated list of lists :) not(matches(b334, '^(47|48|49)$')) or (every $gps in tokenize(normalize-space(b336), '[,;]') satisfies (matches(normalize-space($gps), '[-+]?[0-9]{1,3}(\.[0-9]{1,6})? +[-+]?[0-9]{1,3}(\.[0-9]{1,6})?') and (abs(number(substring-before(normalize-space($gps), ' '))) le 90) and (number(substring-after(normalize-space($gps), ' ')) le 180) and (number(substring-after(normalize-space($gps), ' ')) gt -180)))" />
			<xs:assert id="_20240412_b_3" test="(: EUDR data list must not mix types of location (point, pair, polygon) (must be a semicolon-separated list of lists, list of pairs or a list of points) :) not(matches(b334, '^(47|48|49)$')) or ((every $gps in tokenize(normalize-space(b336), ';') satisfies (string-length($gps) eq string-length(replace($gps, ',', '')))) or (every $gps in tokenize(normalize-space(b336), ';') satisfies (string-length($gps) - string-length(replace($gps, ',', '')) eq 1)) or (every $gps in tokenize(normalize-space(b336), ';') satisfies (string-length($gps) - string-length(replace($gps, ',', '')) ge 2)) )" />
			<xs:assert id="_20240412_b_4" test="(: ProductFormFeatureValue must be an EUDR Due Diligence Statement document reference (with optional verification code) :) (b334 ne '50') or matches(b335, '^[0-9A-Za-z]+(\+[0-9A-Za-z]+)?$')" />
