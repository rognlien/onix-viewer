			<xs:assert id="_20180109_g_4" test="(: For repeats of ContentDate with matching From and To roles, the From date must precede the To date :) if (exists(contentdate[x429 eq '14']) and exists(contentdate[x429 eq '15'])) then (if ((if (exists(contentdate[x429 eq '14']/b306/@dateformat)) then contentdate[x429 eq '14']/b306/@dateformat else if (exists(contentdate[x429 eq '14']/j260)) then contentdate[x429 eq '14']/j260 else '00') eq (if (exists(contentdate[x429 eq '15']/b306/@dateformat)) then contentdate[x429 eq '15']/b306/@dateformat else if (exists(contentdate[x429 eq '15']/j260)) then contentdate[x429 eq '15']/j260 else '00')) then (if ((if (contains(contentdate[x429 eq '14']/b306, '+')) then (contains(contentdate[x429 eq '15']/b306, '+') and (substring-after(contentdate[x429 eq '14']/b306, '+') eq substring-after(contentdate[x429 eq '15']/b306, '+'))) else not(contains(contentdate[x429 eq '15']/b306, '+'))) and (if (contains(contentdate[x429 eq '14']/b306, '-')) then (contains(contentdate[x429 eq '15']/b306, '-') and (substring-after(contentdate[x429 eq '14']/b306, '-') eq substring-after(contentdate[x429 eq '15']/b306, '-'))) else not(contains(contentdate[x429 eq '15']/b306, '-'))) and (matches(contentdate[x429 eq '14']/b306, 'Z') eq matches(contentdate[x429 eq '15']/b306, 'Z'))) then (contentdate[x429 eq '14']/b306 le contentdate[x429 eq '15']/b306) else true()) else true()) else true()" />
			<xs:assert id="_20180109_g_5" test="(: For repeats of ContentDate with matching Available from and Available until roles, the Available from date must precede the Available until date :) if (exists(contentdate[x429 eq '27']) and exists(contentdate[x429 eq '28'])) then (if ((if (exists(contentdate[x429 eq '27']/b306/@dateformat)) then contentdate[x429 eq '27']/b306/@dateformat else if (exists(contentdate[x429 eq '27']/j260)) then contentdate[x429 eq '27']/j260 else '00') eq (if (exists(contentdate[x429 eq '28']/b306/@dateformat)) then contentdate[x429 eq '28']/b306/@dateformat else if (exists(contentdate[x429 eq '28']/j260)) then contentdate[x429 eq '28']/j260 else '00')) then (if ((if (contains(contentdate[x429 eq '27']/b306, '+')) then (contains(contentdate[x429 eq '28']/b306, '+') and (substring-after(contentdate[x429 eq '27']/b306, '+') eq substring-after(contentdate[x429 eq '28']/b306, '+'))) else not(contains(contentdate[x429 eq '28']/b306, '+'))) and (if (contains(contentdate[x429 eq '27']/b306, '-')) then (contains(contentdate[x429 eq '28']/b306, '-') and (substring-after(contentdate[x429 eq '27']/b306, '-') eq substring-after(contentdate[x429 eq '28']/b306, '-'))) else not(contains(contentdate[x429 eq '28']/b306, '-'))) and (matches(contentdate[x429 eq '27']/b306, 'Z') eq matches(contentdate[x429 eq '28']/b306, 'Z'))) then (contentdate[x429 eq '27']/b306 le contentdate[x429 eq '28']/b306) else true()) else true()) else true()" />
			<xs:assert id="_20180109_g_6" test="(: For repeats of ContentDate with matching Associated start and Associated end roles, the Associated start date must precede the Associated end date :) if (exists(contentdate[x429 eq '31']) and exists(contentdate[x429 eq '32'])) then (if ((if (exists(contentdate[x429 eq '31']/b306/@dateformat)) then contentdate[x429 eq '31']/b306/@dateformat else if (exists(contentdate[x429 eq '31']/j260)) then contentdate[x429 eq '31']/j260 else '00') eq (if (exists(contentdate[x429 eq '32']/b306/@dateformat)) then contentdate[x429 eq '32']/b306/@dateformat else if (exists(contentdate[x429 eq '32']/j260)) then contentdate[x429 eq '32']/j260 else '00')) then (if ((if (contains(contentdate[x429 eq '31']/b306, '+')) then (contains(contentdate[x429 eq '32']/b306, '+') and (substring-after(contentdate[x429 eq '31']/b306, '+') eq substring-after(contentdate[x429 eq '32']/b306, '+'))) else not(contains(contentdate[x429 eq '32']/b306, '+'))) and (if (contains(contentdate[x429 eq '31']/b306, '-')) then (contains(contentdate[x429 eq '32']/b306, '-') and (substring-after(contentdate[x429 eq '31']/b306, '-') eq substring-after(contentdate[x429 eq '32']/b306, '-'))) else not(contains(contentdate[x429 eq '32']/b306, '-'))) and (matches(contentdate[x429 eq '31']/b306, 'Z') eq matches(contentdate[x429 eq '32']/b306, 'Z'))) then (contentdate[x429 eq '31']/b306 le contentdate[x429 eq '32']/b306) else true()) else true()) else true()" />
