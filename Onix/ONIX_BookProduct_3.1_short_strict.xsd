			<xs:assert id="_20180308_a_11" test="(: ProductFormDetail codes B201-7 can only be used with appropriate Product forms :) not(exists(b333[matches(., '^(D201|D202|D203|D204|D205|D206|D207)$')])) or matches(b012, '^D.$')" />
