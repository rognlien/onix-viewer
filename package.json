{
  "name": "onix-viewer",
  "version": "0.9.21",
  "private": true,
  "license": "MIT",
  "description": "Chrome extension that pretty-prints raw XML pages with ONIX-aware features.",
  "scripts": {
    "test": "node tests/run.js",
    "test:update-expected": "UPDATE_EXPECTED=1 node tests/run.js expected",
    "test:browser": "node tests/browser/run.js",
    "test:oracle": "node tools/oracle-xmllint.js",
    "test:firefox": "node tests/browser/firefox.js",
    "check:icons": "node tools/check-icons.js",
    "icons": "tools/render-icons.sh",
    "build:dev": "tools/package-extension.sh --dev --target=chrome && tools/package-extension.sh --dev --target=firefox && tools/package-extension.sh --dev --target=safari",
    "clean": "rm -rf dist",
    "screenshots:chrome": "node tools/screenshots.js chrome",
    "screenshots:firefox": "node tools/screenshots.js firefox",
    "screenshots:safari": "node tools/screenshots.js safari",
    "lint": "eslint ."
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jsdom": "^24.0.0",
    "puppeteer-core": "^25.10.0"
  }
}
